OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini


## ------ Search providers --------
# MOCK
SEARCH_PROVIDER=mock
SERPAPI_API_KEY=your_serpapi_key_here


# SERP.     https://serpapi.com/pricing
# SEARCH_PROVIDER=serpapi
# SERPAPI_API_KEY=your_serpapi_key_here

# GOOGLE    https://www.google.com/?
# SEARCH_PROVIDER=google
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# BING:  https://learn.microsoft.com/en-us/lifecycle/announcements/bing-search-api-retirement?
# SEARCH_PROVIDER=bing
# BING_API_KEY=your_existing_bing_key_here
# -------------------------------------------

DATABASE_URL=sqlite:///house_finder.db

MAX_RESULTS_PER_QUERY=10
MAX_URLS_PER_CRITERIA=50
REQUEST_TIMEOUT_SECONDS=12
DELAY_BETWEEN_REQUESTS_SECONDS=1

ENABLE_LIVE_FETCH=false
ENABLE_PLAYWRIGHT_FALLBACK=false